diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index bc7166a..b766c91 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -9,7 +9,7 @@ permissions:
   contents: read
 
 jobs:
-  ci:
+  checks:
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
@@ -93,14 +93,43 @@ jobs:
             echo "no shell scripts yet"
           fi
 
-      - name: Test suite
+      - name: Sharding proof
         run: |
-          # Construction installs tests by filename; this fixed runner makes every
-          # scripts/test/*.test.sh file part of required CI without workflow edits.
-          bash scripts/test/run-all.sh
+          bash scripts/test/run-all-sharding.check.sh
 
       - name: Rename gate
         run: |
           # Patrols tracked files for old names left over from the rename.
           # Lines labeled legacy and scripts/test/ fixtures are exempt.
           bash scripts/check-rename.sh
+
+  test:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: [1, 2, 3, 4, 5, 6]
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - name: Test suite
+        run: |
+          # Construction installs tests by filename; this fixed runner makes every
+          # scripts/test/*.test.sh file part of required CI without workflow edits.
+          bash scripts/test/run-all.sh --shard ${{ matrix.shard }}/6
+
+  ci:
+    runs-on: ubuntu-latest
+    needs: [checks, test]
+    if: always()
+    steps:
+      - name: Gate
+        run: |
+          set -eu
+          echo "checks: ${{ needs.checks.result }}"
+          echo "test:   ${{ needs.test.result }}"
+          if [ "${{ needs.checks.result }}" != "success" ] \
+             || [ "${{ needs.test.result }}" != "success" ]; then
+            echo "ci gate FAILED"; exit 1
+          fi
+          echo "ci gate ok"
