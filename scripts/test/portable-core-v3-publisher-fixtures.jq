def completed_result_doc($request;$request_sha;$resolved;$resolved_sha):
  truth::completed_result_doc($request;$request_sha;$resolved;$resolved_sha) | v3;
def skipped_result_doc($request;$request_sha;$resolved;$resolved_sha):
  truth::skipped_result_doc($request;$request_sha;$resolved;$resolved_sha) | v3;
def stale_result_doc($request;$request_sha;$resolved;$resolved_sha):
  truth::stale_result_doc($request;$request_sha;$resolved;$resolved_sha) | v3;
def blocked_result_doc($request;$request_sha;$resolved;$resolved_sha):
  truth::blocked_result_doc($request;$request_sha;$resolved;$resolved_sha) | v3;
def failed_result_doc($request;$request_sha;$resolved;$resolved_sha):
  truth::failed_result_doc($request;$request_sha;$resolved;$resolved_sha) | v3;
def cancelled_result_doc($request;$request_sha;$resolved;$resolved_sha):
  truth::cancelled_result_doc($request;$request_sha;$resolved;$resolved_sha) | v3;
def sha($character): truth::sha($character);
def content($id;$media;$character): truth::content($id;$media;$character);
def reason($id): truth::reason($id);
def evidence($id;$kind;$verdict): truth::evidence($id;$kind;$verdict);
def output($id;$media;$character): truth::output($id;$media;$character);
def unavailable($id): truth::unavailable($id);
def absent: truth::absent;
def present($value): truth::present($value);
