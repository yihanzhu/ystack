import "portable-core-profile-graph-fixtures" as graph;
import "portable-core-stage-request-fixtures" as request;
import "portable-core-result-truth-fixtures" as truth;
import "portable-core-result-facts-fixtures" as facts;

def v3:
  walk(if type == "object" and has("schema_version") then .schema_version=3 else . end);
def permissions:
  ["core.perm.evidence-publication.create.v3","core.perm.evidence.write.v1","core.perm.target.read.v1"];
def roles: ["forge","producer","publisher","reviewer","verifier"];
def forge_permissions:
  ["core.perm.candidate-repository.write.v2","core.perm.evidence.write.v1",
   "core.perm.scratch.write.v1","core.perm.target.read.v1"];
def manifest($role):
  (if $role == "forge" then
    graph::manifest("publisher") | .id="manifest.forge" |
    .body.package_ref=graph::blob("packages/forge.bin";"6") |
    .body.offered_roles=["forge"] |
    .body.offered_capabilities=["core.forge.materialize-candidate.v2"] |
    .body.offered_permissions=forge_permissions
   else graph::manifest($role) end) | v3 |
  if $role == "publisher" then
    .body.offered_capabilities=["core.publisher.publish-evidence.v3"] |
    .body.offered_permissions=permissions
  else . end;
def binding($role;$shas):
  (if $role == "forge" then
    graph::binding("publisher";$shas) |
    .binding_id="binding.zforge" | .role="forge" |
    .manifest_ref=graph::document_ref("adapter_manifest";"manifest.forge";$shas.forge) |
    .adapter_instance_id="instance.forge" | .principal_id="principal.forge" |
    .execution_boundary_id="boundary.forge" |
    .authority_ref=graph::scope("authority";"authority-forge";graph::sha("5")) |
    .package_ref=graph::blob("packages/forge.bin";"6") |
    .requested_capabilities=["core.forge.materialize-candidate.v2"] |
    .requested_permissions=forge_permissions
   else graph::binding($role;$shas) end) | v3 |
  if $role == "publisher" then
    .requested_capabilities=["core.publisher.publish-evidence.v3"] |
    .requested_permissions=permissions
  else . end;
def profile($shas):
  {schema_version:3,kind:"profile",id:"profile.example",
   body:{profile_version:"v3",bindings:[["producer","publisher","reviewer","verifier","forge"][] | binding(.;$shas)]}};
def resolved($profile;$sha;$shas):
  graph::resolved_profile_doc($profile;$sha;$shas) | v3 |
  .body.bindings |= map(if .binding.role == "forge" then
    .manifest_source=graph::source_value(graph::blob("manifests/forge.json";"a");"canonical-json";$shas.forge)
  else . end);
def row($name):
  {path:("ystack-evidence/incident.example/"+$name),mode:"100644",
   sha256:("a"*64),git_blob_oid:("b"*40),add_only:true};
def publisher_request($resolved_sha):
  request::request_doc("verifier";$resolved_sha) | v3 |
  .id="request.publisher" |
  .body |= (
    .workflow_id="workflow.shadow-evidence-commit" |
    .task_class_id="task.commit-shadow-evidence" | .stage_id="stage.publish" |
    .target_revision=request::present(request::revision("2")) |
    .source=request::present({type:"git-object",value:request::tree("1")}) |
    .operation={role:"publisher",binding_id:"binding.publisher",
      capability_id:"core.publisher.publish-evidence.v3",permissions:permissions,
      arguments:{incident_id:"incident.example",scope_id:"scope.example",
        branch:"ystack/evidence/incident.example",title:"Shadow evidence: incident.example",
        candidate_input_id:"input.candidate",body_input_id:"input.body",
        shadow_input_id:"input.shadow",write_set:[row("record.json")],
        publication_contract:request::delivered("output-contract";"contract";request::sha("3"))}} |
    .inputs=[request::named_tree_input("candidate"),
      (request::named_content_input("body";request::sha("4")) |
       .value.value.value.media_type="text/plain"),
      request::named_content_input("shadow";request::sha("5")),
      request::named_content_input("contract";request::sha("3")),
      request::named_content_input("finish";request::sha("1")),
      request::named_content_input("verify";request::sha("2"))] |
    .inputs |= sort_by(.input_id) |
    .required_evidence_kinds=["deterministic"] |
    .grant_ref=request::scope("grant";"grant";request::sha("6")) |
    .qualification_ref=request::scope("qualification";"qualification";request::sha("7")));
def operation_request($role;$sha):
  if $role == "publisher" then publisher_request($sha)
  elif $role == "forge" then
    request::request_doc("verifier";$sha) | v3 | .id="request.forge" |
    .body.operation={role:"forge",binding_id:"binding.zforge",
      capability_id:"core.forge.materialize-candidate.v2",permissions:forge_permissions,
      arguments:{source_tree_input_id:"input.candidate",candidate_output_id:"output.candidate",
        materialization_contract:request::delivered("output-contract";"plan";request::sha("4")),
        network_mode:"deny"}} | .body.required_evidence_kinds=["deterministic"]
  else request::request_doc($role;$sha) | v3 end;
def action($state;$branch):
  {state:$state} +
  (if $state == "not-attempted" then {} else
    {proof_ref:request::content("proof.publication";"application/json";request::sha("a"))} +
    (if $state != "created" then {}
     elif $branch then {head:request::revision("1")}
     else {change_request_id:"change.example"} end) end);
def post($state;$resolved):
  {state:$state} + (if $state == "not-run" then {} else
    {proof_ref:request::content("proof.post";"application/json";request::sha("b")),
     verified_by:facts::performer([$resolved.body.bindings[] |
       select(.binding.role == "verifier")][0])} end);
def publication($branch;$pr;$post;$resolved):
  {branch:action($branch;true),change_request:action($pr;false),post_write:post($post;$resolved)};
def result($req;$req_sha;$resolved;$resolved_sha):
  truth::completed_result_doc($req;$req_sha;$resolved;$resolved_sha) | v3 |
  if $req.body.operation.role == "publisher" then
    .body.outcome={family:"change",value:"changed"} |
    .body.publication=publication("created";"created";"matched";$resolved)
  elif $req.body.operation.role == "forge" then .body.outcome={family:"change",value:"no-change"}
  else . end;
def nonpassing:
  .body.status="failed" | .body.reason={reason_id:"stage.failed"} |
  .body.outcome={family:"change",value:"inconclusive"} |
  .body.diagnostics=[request::content("diagnostic.failed";"text/plain";request::sha("d"))] |
  .body.evidence |= map(.verdict="inconclusive");
def preexecution($status):
  .body.status=$status | .body.reason={reason_id:("stage."+$status)} |
  .body.outputs=[] | .body.evidence=[] |
  .body.diagnostics=(if $status == "failed" or $status == "blocked" then
    [request::content("diagnostic.failed";"text/plain";request::sha("d"))] else [] end) |
  .body.publication={branch:{state:"not-attempted"},change_request:{state:"not-attempted"},post_write:{state:"not-run"}} |
  del(.body.execution,.body.outcome,.body.started_at,.body.finished_at);

def request_mutation($id):
  if $id | startswith("field-") then
    ($id | capture("^field-(?<field>.+)-(?<mutation>missing|extra|type)$")) as $m |
    if $m.mutation == "missing" then del(.body.operation.arguments[$m.field])
    elif $m.mutation == "extra" then .body.operation.arguments += {extra:true}
    else .body.operation.arguments[$m.field]=null end
  elif $id | startswith("incident-") then
    .body.operation.arguments.incident_id=(
      {empty:"",uppercase:"Upper",slash:"a/b",colon:"a:b","129":("a"*129),
       dotdot:"a..b","trailing-dot":"a.",lock:"a.lock"}[$id[9:]])
  elif $id == "registry-unknown-cap" then .body.operation.capability_id="unknown.cap"
  elif $id == "registry-unknown-perm" then .body.operation.permissions=["unknown.perm"]
  elif $id == "registry-extra-perm" or $id == "registry-candidate-exec" then
    .body.operation.permissions += ["core.perm.candidate.execute.v1"] |
    .body.operation.permissions |= sort
  elif $id | startswith("required-") then
    del(.body[($id[9:]+"_ref")])
  elif $id == "request-workflow" then .body.workflow_id="workflow.other"
  elif $id == "request-task" then .body.task_class_id="task.other"
  elif $id == "request-stage" then .body.stage_id="stage.other"
  elif $id == "request-branch" then .body.operation.arguments.branch="ystack/evidence/other"
  elif $id == "request-title" then .body.operation.arguments.title="Other"
  elif $id == "request-base" then .body.base=request::absent
  elif $id == "request-target" then .body.target_revision=request::absent
  elif $id == "request-candidate-source" then .body.source.value.value.object_id=("9"*40)
  elif $id == "request-candidate-equals-base" then
    .body.source.value.value.revision=.body.base.value |
    .body.inputs |= map(if .input_id == "input.candidate" then
      .value.value.value.revision=request::revision("2") else . end)
  elif $id == "request-repository" then .body.target_repository_id="repo.other"
  elif $id == "request-algorithm" then
    .body.base.value |= (.hash_algorithm="sha256" | .commit_id=("2"*64)) |
    .body.target_revision=.body.base
  elif $id == "input-missing" then .body.inputs |= map(select(.input_id != "input.body"))
  elif $id == "input-wrong-type" then .body.inputs |= map(if .input_id == "input.body" then
    .value={type:"artifact",value:{type:"git-object",value:request::tree("1")}} else . end)
  elif $id == "input-wrong-media" then .body.inputs |= map(if .input_id == "input.body" then
    .value.value.value.media_type="application/json" else . end)
  elif $id == "input-reused-data" then .body.operation.arguments.body_input_id="input.shadow"
  elif $id == "input-instruction-collision" then .body.operation.arguments.body_input_id="input.finish"
  elif $id == "input-contract-mismatch" then
    .body.operation.arguments.publication_contract.ref.subject_ref.value.value.sha256=("0"*64)
  elif $id == "input-duplicate" then .body.inputs += [.body.inputs[0]] | .body.inputs |= sort_by(.input_id)
  elif $id == "row-mode" then .body.operation.arguments.write_set[0].mode="100755"
  elif $id == "row-add-only" then .body.operation.arguments.write_set[0].add_only=false
  elif $id == "row-digest" then .body.operation.arguments.write_set[0].sha256="bad"
  elif $id == "row-malformed-oid" then .body.operation.arguments.write_set[0].git_blob_oid="bad"
  elif $id == "row-path-alias" then .body.operation.arguments.write_set[0].path="a/../b"
  elif $id == "row-path-backslash" then .body.operation.arguments.write_set[0].path="a\\b"
  elif $id == "row-path-control" then .body.operation.arguments.write_set[0].path="a\nb"
  elif $id == "row-path-4097" then .body.operation.arguments.write_set[0].path=("a"*4097)
  elif $id == "row-unsorted" then .body.operation.arguments.write_set=[row("z"),row("a")]
  elif $id == "row-duplicate" then .body.operation.arguments.write_set += .body.operation.arguments.write_set
  elif $id == "row-empty" then .body.operation.arguments.write_set=[]
  elif $id == "row-257" then .body.operation.arguments.write_set=[range(0;257) | row(tostring)] | .body.operation.arguments.write_set |= sort_by(.path)
  elif $id == "row-outside-root" then .body.operation.arguments.write_set[0].path="other/incident.example/a"
  elif $id == "row-nested-filename" then .body.operation.arguments.write_set[0].path="ystack-evidence/incident.example/a/b"
  elif $id == "row-algorithm-length" then .body.operation.arguments.write_set[0].git_blob_oid=("b"*64)
  else error("unknown request mutation: "+$id) end;

def binding_mutation($id):
  if $id == "profile-tool" then .requested_tools=[graph::producer_tool]
  elif $id == "profile-skill" then .skill_refs=[graph::blob("skills/publisher.md";"c")]
  elif $id == "profile-model" or $id == "registry-model-publisher" then
    .execution_kind="model" | .model_request={provider_id:"provider.example",model_id:"model.example",effort_id:"high"} |
    .prompt_ref=graph::blob("prompts/publisher.md";"d")
  elif $id == "profile-prompt" then .prompt_ref=graph::blob("prompts/publisher.md";"d")
  elif $id == "profile-wrong-cap" or $id == "resolved-wrong-cap" then .requested_capabilities=[]
  elif $id == "profile-wrong-perm" or $id == "resolved-wrong-perm" then .requested_permissions=[]
  elif $id == "separation-binding" then .binding_id="binding.producer"
  elif $id == "separation-instance" then .adapter_instance_id="instance.producer"
  elif $id == "separation-principal" then .principal_id="principal.producer"
  elif $id == "separation-boundary" then .execution_boundary_id="boundary.producer"
  elif $id == "separation-authority" then .authority_ref.scope_sha256=graph::sha("1")
  else error("unknown binding mutation: "+$id) end;
def profile_mutation($id):
  if .kind == "profile" then
    .body.bindings |= map(if .role == "publisher" then binding_mutation($id) else . end)
  elif $id | startswith("projection-") then
    .body.bindings |= map(if .binding.role == "publisher" then
      if $id == "projection-manifest" then .manifest_source.value_sha256=("0"*64)
      elif $id == "projection-package" then .package_source.source.object_id=("0"*40)
      elif $id == "projection-config" then .config_source=graph::present(graph::source_value(graph::blob("config/other.json";"1");"raw-bytes";graph::sha("0")))
      elif $id == "projection-skills" then .skill_sources=[graph::source_value(graph::blob("skills/other.md";"1");"raw-bytes";graph::sha("0"))]
      else .tool_sources=[graph::resolved_tool_source] end
    else . end)
  else .body.bindings |= map(if .binding.role == "publisher" then .binding |= binding_mutation($id) else . end)
  end;

def result_mutation($id;$resolved):
  if $id | startswith("union-") then
    ($id | capture("^union-(?<arm>branch|pr|post)-(?<mutation>extra|missing|type|unknown-state)$")) as $m |
    ({branch:"branch",pr:"change_request",post:"post_write"}[$m.arm]) as $key |
    .body.publication[$key] |= (
      if $m.mutation == "extra" then .+{extra:true}
      elif $m.mutation == "missing" then del(.proof_ref)
      elif $m.mutation == "type" then .proof_ref=0
      else .state="other" end)
  elif $id | startswith("effect-") then
    ($id | capture("^effect-(?<branch>not-attempted|absent|created|unknown)-(?<pr>not-attempted|absent|created|unknown)-(?<post>not-run|matched|mismatched|unknown)$")) as $m |
    (if $m.branch == "created" and $m.pr == "created" and $m.post == "matched" then . else nonpassing end) |
    .body.publication=publication($m.branch;$m.pr;$m.post;$resolved) |
    if $m.post == "mismatched" then .body.reason={reason_id:"publisher.post-write-mismatch"} else . end
  elif $id == "no-execution-dispatch" then preexecution("failed") |
    .body.publication.branch=action("absent";true)
  elif $id == "result-outputs" then .body.outputs=[truth::output("output.extra";"application/json";"a")]
  elif $id == "result-delta" then .body.delta_ref=request::content("delta.extra";"text/x-diff";request::sha("a"))
  elif $id == "result-no-change" then .body.outcome.value="no-change"
  elif $id == "result-completed-partial" then .body.publication.change_request=action("not-attempted";false) |
    .body.publication.post_write={state:"not-run"}
  elif $id == "result-completed-unknown" then .body.publication.post_write=post("unknown";$resolved)
  elif $id == "publication-missing" then del(.body.publication)
  elif $id == "cross-attempt-zero" then .body.attempt_number=0
  elif $id == "cross-attempt-two" then .body.attempt_number=2
  elif $id == "cross-head" then .body.publication.branch.head.commit_id=("0"*40)
  elif $id == "cross-verifier" then .body.publication.post_write.verified_by.principal_id="principal.other"
  elif $id == "cross-verifier-shared" then .body.publication.post_write.verified_by=.body.execution.performer
  elif $id | startswith("status-") then
    $id[7:] as $status |
    if $status == "completed" then .
    elif $status == "failed" or $status == "cancelled" then nonpassing | .body.status=$status
    else preexecution($status) |
      if $status == "stale" then .body.stale_observations=[{selector:{kind:"environment"},
        observed:{state:"present",value:{environment_id:"environment.example",fingerprint_sha256:("0"*64)}}}] else . end
    end
  elif ($id | startswith("failed-")) or ($id | startswith("cancelled-")) then
    ($id | capture("^(?<status>failed|cancelled)-(?<detail>.+)$")) as $m |
    if $m.detail == "pre-execution" then preexecution($m.status)
    else nonpassing | .body.status=$m.status |
      .body.publication=(if $m.detail == "branch-only" then publication("created";"not-attempted";"not-run";$resolved)
        elif $m.detail == "unknown" then publication("unknown";"not-attempted";"not-run";$resolved)
        else publication("not-attempted";"not-attempted";"not-run";$resolved) end)
    end
  elif $id == "fact-gap-nonpassing" or $id == "fact-gap-changed" then
    .body.execution.metadata.tools={state:"unavailable",reason_id:"tools.unavailable"} |
    if $id == "fact-gap-nonpassing" then .body.outcome.value="inconclusive" |
      .body.reason={reason_id:"metadata.unavailable"} | .body.evidence |= map(.verdict="inconclusive") else . end
  elif $id == "identity-mismatch-nonpassing" or $id == "identity-mismatch-passed" then
    .body.execution.actual_binding.principal_id="principal.other" |
    .body.execution.performer.principal_id="principal.other" |
    .body.reported_by.principal_id="principal.other" |
    .body.outcome.value="inconclusive" | .body.reason={reason_id:"identity.mismatch"} |
    if $id == "identity-mismatch-nonpassing" then .body.evidence |= map(.verdict="inconclusive") else . end
  elif $id == "nonpassing-changed" then .body.evidence |= map(.verdict="inconclusive")
  elif $id == "post-mismatch-completed" then .body.publication.post_write=post("mismatched";$resolved)
  elif $id == "ref-request" then .body.request_ref.sha256=("0"*64)
  elif $id == "ref-resolved" then .body.resolved_profile_ref.sha256=("0"*64)
  elif $id == "time-before-request" then .body.started_at="2026-08-29T00:00:00Z"
  else error("unknown result mutation: "+$id) end;


def inherited_cases:
  [
    {suite:"schema",case_id:"exact-fields-valid",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"{a:1} | schema::exact_fields([\"a\"];[])"},
    {suite:"schema",case_id:"exact-fields-extra",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"{a:1,b:2} | schema::exact_fields([\"a\"];[])"},
    {suite:"schema",case_id:"bounded-set-min-max",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"[\"a\",\"b\"] | schema::bounded_set(1;2;type == \"string\";.)"},
    {suite:"schema",case_id:"bounded-set-reversed",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"[\"b\",\"a\"] | schema::bounded_set(1;2;type == \"string\";.)"},
    {suite:"schema",case_id:"bounded-set-duplicate",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"[\"a\",\"a\"] | schema::bounded_set(1;2;type == \"string\";.)"},
    {suite:"schema",case_id:"bounded-set-one-over",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"[\"a\",\"b\",\"c\"] | schema::bounded_set(1;2;type == \"string\";.)"},
    {suite:"schema",case_id:"permission-set-order-valid",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"[\"core.perm.evidence.write.v1\",\"core.perm.target.read.v1\"] | schema::enum_set_ok(0;5;schema::permission_ids)"},
    {suite:"schema",case_id:"permission-set-order-invalid",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"[\"core.perm.target.read.v1\",\"core.perm.evidence.write.v1\"] | schema::enum_set_ok(0;5;schema::permission_ids)"},
    {suite:"schema",case_id:"present-absent",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"{state:\"absent\"} | schema::present_ok(schema::id_ok)"},
    {suite:"schema",case_id:"present-value",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"{state:\"present\",value:\"value.example\"} | schema::present_ok(schema::id_ok)"},
    {suite:"schema",case_id:"present-null",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"{state:\"present\",value:null} | schema::present_ok(schema::id_ok)"},
    {suite:"schema",case_id:"present-extra",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"{state:\"absent\",value:\"no\"} | schema::present_ok(schema::id_ok)"},
    {suite:"schema",case_id:"id-boundary",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"((\"a\" * 128) | schema::id_ok) and (\"a\" | schema::id_ok)"},
    {suite:"schema",case_id:"id-one-over",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"(\"a\" * 129) | schema::id_ok"},
    {suite:"schema",case_id:"id-uppercase",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"\"Bad\" | schema::id_ok"},
    {suite:"schema",case_id:"id-trailing-newline",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"\"id.example\\n\" | schema::id_ok"},
    {suite:"schema",case_id:"int-boundaries",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"(0 | schema::int_ok) and (2147483647 | schema::int_ok)"},
    {suite:"schema",case_id:"int-negative",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"-1 | schema::int_ok"},
    {suite:"schema",case_id:"int-one-over",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"2147483648 | schema::int_ok"},
    {suite:"schema",case_id:"int-float",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"1.5 | schema::int_ok"},
    {suite:"schema",case_id:"int-negative-zero",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"-0 | schema::int_ok"},
    {suite:"schema",case_id:"sha-valid",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"$f.valid.sha256 | schema::sha256_ok"},
    {suite:"schema",case_id:"sha-invalid",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"\"Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" | schema::sha256_ok"},
    {suite:"schema",case_id:"sha-trailing-newline",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"($f.valid.sha256 + \"\\n\") | schema::sha256_ok"},
    {suite:"schema",case_id:"short-text-boundary",role:"producer",
     expected:"true",mapped:null,graph:"",
     expression:"((\"a\" * 1024) | schema::short_text_ok) and (\"\u00e9\" | schema::short_text_ok)"},
    {suite:"schema",case_id:"short-text-empty",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"\"\" | schema::short_text_ok"},
    {suite:"schema",case_id:"short-text-one-over",role:"producer",
     expected:"false",mapped:null,graph:"",
     expression:"(\"a\" * 1025) | schema::short_text_ok"},
    {suite:"schema",case_id:"short-text-byte-over",role:"producer",
